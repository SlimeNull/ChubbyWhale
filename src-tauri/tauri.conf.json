{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chubby Whale",
  "mainBinaryName": "chubby-whale",
  "version": "0.1.0",
  "identifier": "org.chubbywhale.pet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "大肥鱼",
        "url": "index.html",
        "width": 332,
        "height": 290,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      },
      {
        "label": "bubble",
        "title": "大肥鱼 · 气泡",
        "url": "bubble.html",
        "width": 240,
        "height": 150,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "x": -1000,
        "y": -1000
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "category": "Entertainment",
    "resources": {
      "../skins/": "skins/"
    },
    "shortDescription": "大肥鱼桌面宠物",
    "longDescription": "Chubby Whale (大肥鱼) — an open-source desktop pet starring the community whale girl.",
    "copyright": "Chubby Whale contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
